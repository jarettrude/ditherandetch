{
  "name": "ditherandetch",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "stylelint": "stylelint \"**/*.{css,scss,astro,svelte}\"",
    "stylelint:fix": "stylelint \"**/*.{css,scss,astro,svelte}\" --fix",
    "markdownlint": "markdownlint-cli2 \"**/*.md\"",
    "markdownlint:fix": "markdownlint-cli2 \"**/*.md\" --fix",
    "type-check": "tsc --noEmit",
    "sync:types": "astro sync && tsc --noEmit",
    "clean": "rm -rf dist",
    "dev": "astro dev",
    "sync": "astro sync",
    "build": "astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "heic-to": "^1.5.2",
    "sharp": "^0.35.4",
    "svelte": "^5.57.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "markdownlint-cli2": "^0.23.2",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2"
  }
}
